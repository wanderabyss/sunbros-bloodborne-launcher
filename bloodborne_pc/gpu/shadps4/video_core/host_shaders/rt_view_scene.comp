// bbport: the "Ray tracing scene" debug view (vk_rt_effects.h DrawDebugView): a ray from the
// camera through each render pixel against RayTracing's scene, coloured by what it finds there
// compared with the game's depth, as rt_check.comp classifies its samples:
//   - solid geometry drawn this frame: grey, tinted per structure (a hash of its slot, so one
//     object keeps one tint and a swapped identity shows as a colour change);
//   - see-through geometry (foliage, fences, grates; drawn this frame): green, brighter the more
//     of it blocks light (its learned coverage, rt_common.glsl Coverage);
//   - kept casters (drawn on an earlier frame, kept for the effects' rays): orange;
//   - geometry clearly in front of what the game drew: magenta (gaps the structure fills);
//   - nothing where the game drew something, or only farther away: red (a caster is missing);
//   - sky: dark blue.
// Shaded by the depth's normal so shapes stay readable. Out: RGBA8, render size.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require
#include "rt_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // D32, 0 near .. 1 far (D3D projection)
layout(binding = 1) uniform accelerationStructureEXT scene;
layout(binding = 2, rgba8) uniform writeonly image2D out_image;

layout(push_constant) uniform Constants {
    uint64_t frame; // FrameConstants
    uint64_t stats; // CoverageStats
};

vec3 ViewPosition(FrameConstants f, ivec2 pixel, float depth) {
    const vec2 uv = (vec2(pixel) + 0.5) / f.size - f.jitter / f.size;
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const float z = f.proj.w / min(depth - f.proj.z, -1e-8);
    return vec3(ndc.x * z / f.proj.x, ndc.y * z / f.proj.y, z);
}

float Depth(ivec2 p, ivec2 size) {
    return texelFetch(depth_tex, clamp(p, ivec2(0), size - 1), 0).r;
}

// The closest hit on instances in `mask` along `dir` (opaque: every candidate counts), or -1;
// `slot` gets its structure's slot.
float Closest(uint mask, vec3 dir, float reach, out uint slot) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, mask, vec3(0.0), 0.01, dir, reach);
    while (rayQueryProceedEXT(query)) {
    }
    slot = 0u;
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return -1.0;
    }
    slot = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    return rayQueryGetIntersectionTEXT(query, true);
}

vec3 SlotTint(uint slot) {
    uint h = slot * 2654435769u;
    h ^= h >> 15u;
    h *= 2246822519u;
    h ^= h >> 13u;
    const vec3 c = vec3(uvec3(h, h >> 8u, h >> 16u) & 0xFFu) / 255.0;
    return mix(vec3(0.75), c, 0.35);
}

void main() {
    FrameConstants f = FrameConstants(frame);
    const ivec2 size = ivec2(f.size);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(out_image)))) {
        return;
    }
    if (any(greaterThanEqual(pixel, size))) {
        imageStore(out_image, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    const float depth = Depth(pixel, size);
    if (depth >= 1.0) {
        imageStore(out_image, pixel, vec4(0.04, 0.05, 0.12, 1.0));
        return;
    }
    const vec3 p = ViewPosition(f, pixel, depth);
    const float dist = length(p);
    if (!(dist > 0.05 && dist < 3000.0)) {
        imageStore(out_image, pixel, vec4(0.04, 0.05, 0.12, 1.0));
        return;
    }
    // Shading: the depth's normal against a light from the camera's upper left.
    const vec3 px = ViewPosition(f, pixel + ivec2(1, 0), Depth(pixel + ivec2(1, 0), size)) - p;
    const vec3 py = ViewPosition(f, pixel + ivec2(0, 1), Depth(pixel + ivec2(0, 1), size)) - p;
    vec3 n = normalize(cross(py, px));
    if (dot(n, p) > 0.0) {
        n = -n;
    }
    const float shade = any(isnan(n)) ? 0.7
                                      : 0.35 + 0.65 * max(dot(n, normalize(vec3(-0.4, 0.6, -0.7))), 0.0);
    const vec3 dir = p / dist;
    const float reach = dist * 1.5 + 1.0;
    // The masks of rt_instances.comp: 0x01 solid, 0x02 see-through, 0x08 / 0x10 the same kept.
    uint solid_slot, through_slot, kept_slot;
    const float solid = Closest(0x01u, dir, reach, solid_slot);
    const float through = Closest(0x02u, dir, reach, through_slot);
    const float kept = Closest(0x18u, dir, reach, kept_slot);
    float t = -1.0;
    vec3 color = vec3(0.0);
    if (solid >= 0.0) {
        t = solid;
        color = SlotTint(solid_slot);
    }
    if (through >= 0.0 && (t < 0.0 || through < t)) {
        t = through;
        color = vec3(0.1, 0.35 + 0.65 * Coverage(CoverageStats(stats), through_slot, 0.5), 0.15);
    }
    if (kept >= 0.0 && (t < 0.0 || kept < t)) {
        t = kept;
        color = vec3(1.0, 0.55, 0.1);
    }
    const float tolerance = dist * 0.01 + 0.02;
    if (t < 0.0 || t > dist + tolerance) {
        color = vec3(1.0, 0.1, 0.1);
    } else if (t < dist - tolerance) {
        color = vec3(1.0, 0.2, 0.9);
    }
    imageStore(out_image, pixel, vec4(color * shade, 1.0));
}
