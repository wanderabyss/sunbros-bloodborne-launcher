+// bbport (BBSC 0.0.2's rejoin fix): a peer that comes back on a new connection (after a Blank or
+// a reload) and asks for activation while this side still has the old one established gets a
+// new handshake. Before, the old one stayed "established", a peer that waits for the Offer
+// (BBSC's own clients do) got none and the connection went DEAD after 30 s. Activation requests
+// come once per connection, so a peer with a second connection costs one handshake at most.
+bool PeerStartedOverLocked(const NpSignaling::PeerTransport& transport, u32 from_conn_id) {
+    return transport.state == NpSignaling::ConnState::Established && from_conn_id != 0 &&
+           transport.peer_conn_id != 0 && from_conn_id != transport.peer_conn_id;
+}
+
+void RestartTransportHandshakeLocked(NpSignaling::PeerTransport& transport, u32 new_peer_conn,
+                                     const char* why) {
+    LOG_INFO(Lib_NpSignaling,
+             "Transport {} to '{}': {} (its connection {} -> {}) - handshake again",
+             transport.transport_id, OnlineIdString(transport.online_id), why,
+             transport.peer_conn_id, new_peer_conn);
+    transport.peer_conn_id = new_peer_conn;
+    transport.transport_established_fired = false;
+    transport.peer_established = false;
+    transport.last_handshake_send_us = 0;
+    SetTransportStateLocked(transport, NpSignaling::ConnState::WaitOffer);
+    SyncSig1ConnectionsForTransportLocked(transport.transport_id);
+}
+
+// The peer's id for the connection, from its packets: kept while the connection is established
+// (a different one there means it started over), else taken.
+void NotePeerConnIdLocked(NpSignaling::PeerTransport& transport, u32 from_conn_id) {
+    if (from_conn_id != 0 &&
+        (transport.peer_conn_id == 0 || transport.state != NpSignaling::ConnState::Established)) {
+        transport.peer_conn_id = from_conn_id;
+    }
+}
