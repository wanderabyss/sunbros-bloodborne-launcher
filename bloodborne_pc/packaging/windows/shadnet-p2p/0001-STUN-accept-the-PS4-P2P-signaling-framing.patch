From e0cb4a082836f61b0e570e64ebb2f1821f42872f Mon Sep 17 00:00:00 2001
From: Jgamrot <145107244+Jgamrot@users.noreply.github.com>
Date: Thu, 15 Oct 2026 21:42:44 +0100
Subject: [PATCH] STUN: accept the PS4 P2P signaling framing as well as
 shadp2p's

shadPS4 0.20 (and the official shadNet server) frame signaling datagrams
as a PS4 P2P datagram, [FF][83][FFFF][FFFF][payload]; this server only
took shadp2p's [FFFF][FFFF][payload] and dropped the rest, so 0.20
clients never learned their external address and Matching2 signaling
between them failed. The payload is the same 21-byte ping; the reply
now goes back in the framing its request used.

SHADNET_SYSTEM_PROTOBUF=ON builds against an installed protobuf (MSYS2
CLANG64's) instead of fetching externals/protobuf.

For BBport (Jgamrot/bloodborne_pc) seamless co-op with BBSC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt      | 21 +++++++++++++++++----
 src/stun_server.cpp | 43 ++++++++++++++++++++++++++++++++-----------
 src/stun_server.h   |  4 +++-
 3 files changed, 52 insertions(+), 16 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1f13480..ee54a84 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,7 +20,20 @@ endif()
 
 find_package(Qt6 REQUIRED COMPONENTS Core Network Sql Concurrent HttpServer)
 
-add_subdirectory(externals)
+# bbport: SHADNET_SYSTEM_PROTOBUF=ON builds against an installed protobuf (MSYS2 CLANG64's)
+# instead of fetching and building externals/protobuf.
+option(SHADNET_SYSTEM_PROTOBUF "Use an installed protobuf instead of externals/protobuf" OFF)
+if(SHADNET_SYSTEM_PROTOBUF)
+    find_package(Protobuf CONFIG REQUIRED)
+    set(SHADNET_PROTOC "$<TARGET_FILE:protobuf::protoc>")
+    set(SHADNET_PROTOC_DEP "")
+    set(SHADNET_LIBPROTOBUF protobuf::libprotobuf)
+else()
+    add_subdirectory(externals)
+    set(SHADNET_PROTOC "$<TARGET_FILE:protoc>")
+    set(SHADNET_PROTOC_DEP protoc)
+    set(SHADNET_LIBPROTOBUF libprotobuf)
+endif()
 
 set(PROTO_OUT "${CMAKE_CURRENT_BINARY_DIR}/proto_gen")
 file(MAKE_DIRECTORY "${PROTO_OUT}")
@@ -29,13 +42,13 @@ add_custom_command(
     OUTPUT
         "${PROTO_OUT}/shadnet.pb.cc"
         "${PROTO_OUT}/shadnet.pb.h"
-    COMMAND $<TARGET_FILE:protoc>
+    COMMAND ${SHADNET_PROTOC}
         "--proto_path=${CMAKE_CURRENT_SOURCE_DIR}/src"
         "--cpp_out=${PROTO_OUT}"
         "${CMAKE_CURRENT_SOURCE_DIR}/src/shadnet.proto"
     DEPENDS
         "${CMAKE_CURRENT_SOURCE_DIR}/src/shadnet.proto"
-        protoc
+        ${SHADNET_PROTOC_DEP}
     COMMENT "Generating shadnet protobuf sources"
     VERBATIM
 )
@@ -105,7 +118,7 @@ target_link_libraries(shadnet PRIVATE
     Qt6::Sql
     Qt6::Concurrent
     Qt6::HttpServer
-    libprotobuf
+    ${SHADNET_LIBPROTOBUF}
 )
 
 if(BUILD_TESTING)
diff --git a/src/stun_server.cpp b/src/stun_server.cpp
index a61d5bd..deb75a8 100644
--- a/src/stun_server.cpp
+++ b/src/stun_server.cpp
@@ -5,20 +5,39 @@
 #include "stream_extractor.h"
 #include "stun_server.h"
 
-// Must match the client's SIGNALING_VPORT_NBO / VPORT_HEADER_SIZE
+// Signaling datagrams come in two framings, and a reply goes back in the one its request used:
+// - shadp2p's: [src vport FFFF][dst vport FFFF][payload] (shadp2p clients, BBport before 1.9.5);
+// - the PS4 P2P datagram that the official shadNet server and shadPS4 0.20 use:
+//   [0xFF][0x80 | 3][src vport FFFF][dst vport FFFF][payload] (bbport: added so 0.20 clients
+//   can reach this server's STUN; their payload is the same).
 static constexpr uint16_t SIGNALING_VPORT_NBO = 0xFFFF;
 static constexpr int VPORT_HEADER_SIZE = 4;
+static constexpr char PS4_SIGNALING_HEADER[] = {char(0xFF), char(0x83), char(0xFF),
+                                                 char(0xFF), char(0xFF), char(0xFF)};
+static constexpr int PS4_HEADER_SIZE = sizeof(PS4_SIGNALING_HEADER);
 
-static QByteArray FrameSignaling(const QByteArray& payload) {
+enum class Framing { Vport, Ps4 };
+
+static QByteArray FrameSignaling(const QByteArray& payload, Framing framing) {
     QByteArray framed;
-    framed.reserve(VPORT_HEADER_SIZE + payload.size());
-    framed.append(reinterpret_cast<const char*>(&SIGNALING_VPORT_NBO), 2);
-    framed.append(reinterpret_cast<const char*>(&SIGNALING_VPORT_NBO), 2);
+    if (framing == Framing::Ps4) {
+        framed.reserve(PS4_HEADER_SIZE + payload.size());
+        framed.append(PS4_SIGNALING_HEADER, PS4_HEADER_SIZE);
+    } else {
+        framed.reserve(VPORT_HEADER_SIZE + payload.size());
+        framed.append(reinterpret_cast<const char*>(&SIGNALING_VPORT_NBO), 2);
+        framed.append(reinterpret_cast<const char*>(&SIGNALING_VPORT_NBO), 2);
+    }
     framed.append(payload);
     return framed;
 }
 
-static QByteArray StripVportHeader(const QByteArray& data) {
+static QByteArray StripSignalingHeader(const QByteArray& data, Framing* framing) {
+    if (data.size() > PS4_HEADER_SIZE &&
+        memcmp(data.constData(), PS4_SIGNALING_HEADER, PS4_HEADER_SIZE) == 0) {
+        *framing = Framing::Ps4;
+        return data.mid(PS4_HEADER_SIZE);
+    }
     if (data.size() < VPORT_HEADER_SIZE)
         return {};
     uint16_t src_vp, dst_vp;
@@ -26,6 +45,7 @@ static QByteArray StripVportHeader(const QByteArray& data) {
     memcpy(&dst_vp, data.constData() + 2, 2);
     if (src_vp != SIGNALING_VPORT_NBO || dst_vp != SIGNALING_VPORT_NBO)
         return {}; // not a signaling packet
+    *framing = Framing::Vport;
     return data.mid(VPORT_HEADER_SIZE);
 }
 
@@ -55,15 +75,16 @@ void StunServer::OnReadyRead() {
         if (raw.isEmpty())
             continue;
 
-        // Strip signaling vport header
-        QByteArray data = StripVportHeader(raw);
+        // Strip the signaling header, whichever framing the client used
+        Framing framing = Framing::Vport;
+        QByteArray data = StripSignalingHeader(raw, &framing);
         if (data.isEmpty())
             continue;
 
         uint8_t cmd = static_cast<uint8_t>(data[0]);
         switch (cmd) {
         case 0x01:
-            HandleStunPing(data, sender, senderPort);
+            HandleStunPing(data, sender, senderPort, framing == Framing::Ps4);
             break;
         default:
             break;
@@ -72,7 +93,7 @@ void StunServer::OnReadyRead() {
 }
 
 void StunServer::HandleStunPing(const QByteArray& data, const QHostAddress& sender,
-                                uint16_t senderPort) {
+                                uint16_t senderPort, bool ps4Framing) {
     // cmd(1) + online_id(16) + local_ip(4) = 21 bytes minimum
     if (data.size() < 21)
         return;
@@ -105,5 +126,5 @@ void StunServer::HandleStunPing(const QByteArray& data, const QHostAddress& send
     QByteArray response;
     response.append(reinterpret_cast<const char*>(&ipNet), 4);
     response.append(reinterpret_cast<const char*>(&portNet), 2);
-    m_socket->writeDatagram(FrameSignaling(response), sender, senderPort);
+    m_socket->writeDatagram(FrameSignaling(response, ps4Framing ? Framing::Ps4 : Framing::Vport), sender, senderPort);
 }
diff --git a/src/stun_server.h b/src/stun_server.h
index c95a01b..555f661 100644
--- a/src/stun_server.h
+++ b/src/stun_server.h
@@ -16,7 +16,9 @@ private slots:
     void OnReadyRead();
 
 private:
-    void HandleStunPing(const QByteArray& data, const QHostAddress& sender, uint16_t senderPort);
+    // bbport: ps4Framing - the request came in the PS4 P2P framing; the reply goes back in it.
+    void HandleStunPing(const QByteArray& data, const QHostAddress& sender, uint16_t senderPort,
+                        bool ps4Framing);
 
     QUdpSocket* m_socket;
     SharedState* m_shared;
-- 
2.47.1.windows.2

